T = int(input())
for test_case in range(1, T + 1):
    count = 0
    a, b, N = map(int, input().split())
    while not(a > N or b > N): # 조건식 a <= N and b <= N으로 작성 가능(가독성 측면)
        if a >= b:
            b += a
        else: a += b
        count += 1
    print(count)

