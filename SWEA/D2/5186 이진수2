T = int(input())
for test_case in range(1, T + 1):
    cnt = 0
    N = float(input())
    result = ""
    b = 0.5
    while N > 10**(-13):
        if N >= b:
            N -= b
            result += '1'
        else: result += '0'
        b *= 0.5
        cnt += 1
    if cnt > 12:
        result = "overflow"
    print(f"#{test_case} {result}")

# 핵심 발상
# 정수를 이진수로 변환할 때 2로 나누면서 나머지를 구함.
# 소수는 반대로 2를 곱하면서 정수 부분을 꺼낸다.